{%- comment -%}
  Sondaggio (i sondaggi si gestiscono in Contenuto → Sondaggi). widget.data.poll è il sondaggio scelto nelle
  impostazioni o il più recente aperto; senza sondaggi il widget non compare.
{%- endcomment -%}
{%- assign poll = widget.data.poll -%}
{%- if poll %}
<div class="Widget widget poll-widget">
    {%- if widget.show_title and widget.title != '' %}<h4 class="WidgetHeader widget-header">{{ widget.title }}</h4>{% endif %}
    <div class="WidgetContent widget-content">
        {% include 'poll-view' %}
        {%- if widget.data.archive_url != '' %}<p class="poll-archive"><a href="{{ widget.data.archive_url }}">{{ 'pollsPrevious' | t }}</a></p>{% endif %}
    </div>
</div>
{%- endif %}

{%- comment -%}
  Tema Terminal: elenco dei post (home, categoria, tag, autore, data) con la zona di widget
  "between-posts" dopo il post indicato dal campo personalizzato (0 = mai), pensata per gli annunci.
{%- endcomment -%}
{%- assign ad_after = 'Between-posts zone after post n. (0 = never)' | theme_field: '3' | plus: 0 -%}
{%- if list_title != '' %}
<h2 class="page-global-title post-list-title">{{ list_title }}</h2>
{%- endif %}
<div id="posts" class="posts">
{%- for post in posts %}
    {%- assign location = 'list' %}
    {% include 'post-view' %}
    {%- if forloop.index == ad_after %}
    <div class="between-posts">{% widget_zone 'between-posts' %}</div>
    {%- endif %}
{%- else %}
    <p class="no-posts">{{ 'noPostsMatchedYourCriteria' | t }}</p>
{%- endfor %}
</div>
{% include 'pager' %}

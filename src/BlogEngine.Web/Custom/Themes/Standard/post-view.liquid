{%- comment -%} Tema Standard: porting di PostView.ascx (elenco: location = 'list'; post singolo: location = 'single'). {%- endcomment -%}
{%- assign image_position = 'Post Thumbnail position' | theme_field: 'top' -%}
{%- assign blog_logo = 'Publisher Logo' | theme_field: 'http://exampleblog.com/logo.png' -%}
{%- if location != 'single' %}
<article class="post-home post-home-{{ image_position }}" id="post{{ post.index }}">
    <div class="post-home-inner">
        {%- if post.first_image != '' %}
        <a class="post-cover" href="{{ post.url }}"><img src="{{ post.first_image }}" alt="{{ post.title }}"></a>
        {%- endif %}
        <header class="post-header">
            <div class="post-meta">
                <span class="post-author"><i class="fa fa-user"></i> <a href="{{ post.author_url }}">{{ post.author_name }}</a></span>
                <span class="post-date"><i class="fa fa-clock-o"></i> {{ post.date_created | date_format: 'MMM dd, yyyy' }}</span>
                {%- if post.categories.size > 0 %}
                <span class="post-category"><i class="fa fa-folder-open"></i> {% for c in post.categories %}<a href="{{ c.url }}">{{ c.title }}</a>{% unless forloop.last %}, {% endunless %}{% endfor %}</span>
                {%- endif %}
            </div>
            <h2 class="post-title"><a class="post-link" href="{{ post.url }}">{{ post.title }}</a></h2>
        </header>
        <p class="post-description">{% if post.description != '' %}{{ post.description }}{% else %}{{ post.plain_description | truncate: 300, '' }}{% endif %}...</p>
        <a href="{{ post.url }}" class="btn btn-outline-dark post-more">read more</a>
    </div>
</article>
{%- else %}
<article class="post-single{% if post.first_image == '' %} no-thumbnail{% endif %}" id="post{{ post.index }}">
    <header class="post-header">
        <h1 class="post-title">{{ post.title }}</h1>
        <div class="post-meta">
            <span class="post-author"><i class="fa fa-user"></i> <a href="{{ post.author_url }}">{{ post.author_name }}</a></span>
            <span class="post-date"><i class="fa fa-clock-o"></i> {{ post.date_created | date_format: 'MMM dd, yyyy' }}</span>
            {%- if post.categories.size > 0 %}
            <span class="post-category"><i class="fa fa-folder-open"></i> {% for c in post.categories %}<a href="{{ c.url }}">{{ c.title }}</a>{% unless forloop.last %}, {% endunless %}{% endfor %}</span>
            {%- endif %}
            {%- assign share_url = post.absolute_url | url_encode %}
            {%- assign share_title = post.title | url_encode %}
            <div class="dropdown post-share float-md-right">
                <a class="dropdown-toggle" href="#" role="button" id="dropdownMenuLink" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false"><i class="fa fa-share-alt"></i>{{ 'share' | t }}</a>
                <div class="dropdown-menu dropdown-menu-right" aria-labelledby="dropdownMenuLink">
                    <a class="dropdown-item item-fb" href="https://www.addtoany.com/add_to/facebook?linkurl={{ share_url }}&amp;linkname={{ share_title }}" target="_blank"><i class="fa fa-facebook-square"></i>Facebook</a>
                    <a class="dropdown-item item-tw" href="https://www.addtoany.com/add_to/twitter?linkurl={{ share_url }}&amp;linkname={{ share_title }}" target="_blank"><i class="fa fa-twitter-square"></i>Twitter</a>
                    <a class="dropdown-item item-ln" href="https://www.addtoany.com/add_to/linkedin?linkurl={{ share_url }}&amp;linkname={{ share_title }}" target="_blank"><i class="fa fa-linkedin-square"></i>LinkedIn</a>
                    <a class="dropdown-item item-pi" href="https://www.addtoany.com/add_to/pinterest?linkurl={{ share_url }}&amp;linkname={{ share_title }}" target="_blank"><i class="fa fa-pinterest-square"></i>Pinterest</a>
                    <a class="dropdown-item item-em" href="https://www.addtoany.com/add_to/email?linkurl={{ share_url }}&amp;linkname={{ share_title }}" target="_blank"><i class="fa fa-envelope-square"></i>Email</a>
                    <a class="dropdown-item item-em" href="https://www.addtoany.com/share?linkurl={{ share_url }}&amp;linkname={{ share_title }}" target="_blank"><i class="fa fa-plus-square"></i>{{ 'share' | t }}...</a>
                </div>
            </div>
        </div>
    </header>
    <section class="post-body content-stlye">
        {{ post.body }}
    </section>
    <footer class="post-footer">
        <div class="post-tags">{% for tag in post.tags %}<a href="{{ tag.url }}" rel="tag">{{ tag.title }}</a>{% unless forloop.last %}, {% endunless %}{% endfor %}</div>
        {{ post.rating_html }}
        {%- if post.admin_links != '' %}<div class="post-adminlinks">{{ post.admin_links }}</div>{% endif %}
    </footer>
</article>
<script type="application/ld+json">
    {
        "@context": "http://schema.org",
        "@type": "NewsArticle",
        "mainEntityOfPage": { "@type": "WebPage", "@id": {{ post.absolute_url | json }} },
        "headline": {{ post.title | json }},
        {%- if post.absolute_first_image != '' %}
        "image": {{ post.absolute_first_image | json }},
        {%- endif %}
        "datePublished": "{{ post.date_created | date_format: 'yyyy-MM-dd' }}",
        "dateModified": "{{ post.date_modified | date_format: 'yyyy-MM-dd' }}",
        "author": { "@type": "Person", "name": {{ post.author_name | json }} },
        "publisher": {
            "@type": "Organization",
            "name": {{ blog.name | json }},
            "logo": { "@type": "ImageObject", "url": {{ blog_logo | json }} }
        },
        "description": {{ post.plain_description | json }}
    }
</script>
{%- endif %}

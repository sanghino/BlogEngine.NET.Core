{%- comment -%} Tema Standard: porting di PostNavigation.ascx. {%- endcomment -%}
<div id="postnavigation" class="navigation-posts row">
    <div class="col-6 text-left prev-post">
        {%- if navigation.previous_url != '' %}
        <a href="{{ navigation.previous_url }}" class="nav-prev"><i class="fa fa-chevron-left"></i> Previous Post</a>
        {%- endif %}
    </div>
    <div class="col-6 text-right next-post">
        {%- if navigation.next_url != '' %}
        <a href="{{ navigation.next_url }}" class="nav-next">Next Post <i class="fa fa-chevron-right"></i></a>
        {%- endif %}
    </div>
</div>

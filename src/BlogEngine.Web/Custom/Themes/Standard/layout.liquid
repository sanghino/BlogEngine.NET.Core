{%- comment -%}
  Tema Standard (porting di site.master e page.master). Le pagine diverse da elenco e post
  (pagine, archivio, contatti, ricerca, errori) usavano page.master: cambiano solo la classe del
  contenuto e il link di accesso nel menu.
{%- endcomment -%}
{%- assign is_page = true %}
{%- if template == 'index' or template == 'post' %}{% assign is_page = false %}{% endif -%}
<!DOCTYPE html>
<html lang="{{ blog.language }}">
<head>
    <meta charset="utf-8" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{{ page_title }}</title>
    <link href="{{ 'src/css/bootstrap.min.css' | theme_url }}" rel="stylesheet" />
    <link href="{{ 'src/css/font-awesome.min.css' | theme_url }}" rel="stylesheet" />
    <link href="{{ 'src/css/styles.min.css' | theme_url }}" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css?family=Roboto:400,500,700" rel="stylesheet">
    {{ content_for_header }}
    <link href="{{ 'Scripts/syntaxhighlighter/styles/shCore.css' | app_url }}" rel="stylesheet" type="text/css" />
    <link href="{{ 'Scripts/syntaxhighlighter/styles/shThemeDefault.css' | app_url }}" rel="stylesheet" type="text/css" />
    <script src="{{ 'Scripts/syntaxhighlighter/scripts/XRegExp.js' | app_url }}"></script>
    <script src="{{ 'Scripts/syntaxhighlighter/scripts/shCore.js' | app_url }}"></script>
    <script src="{{ 'Scripts/syntaxhighlighter/scripts/shAutoloader.js' | app_url }}"></script>
    <script src="{{ 'Scripts/syntaxhighlighter/shActivator.js' | app_url }}"></script>
</head>
<body class="{{ 'LangDirection' | t }}">
    <!-- START HEADER -->
    <header class="blog-header container">
        <nav class="d-flex">
            <h1 class="blog-logo my-auto">
                <a href="{{ blog.url }}">{{ blog.name }}</a>
            </h1>
            <button class="blog-nav-toggle hamburger ml-auto my-auto color-dark hamburger--squeeze" type="button">
                <span class="hamburger-box">
                    <span class="hamburger-inner"></span>
                </span>
            </button>
        </nav>
    </header>
    <!-- END HEADER -->

    <!-- START CONTENT -->
    <div class="container blog-content{% if is_page %} content-stlye{% endif %}">
        {{ content_for_layout }}
    </div>
    <!-- END CONTENT -->

    <div class="blog-sidebar">
        <div class="blog-sidebar-inner">
            <ul class="blog-nav">
                <li><a href="{{ blog.url }}">{{ 'home' | t }}</a></li>
                {%- for parent in blog.pages %}
                <li>
                    <a href="{{ parent.url }}">{{ parent.title }}</a>
                    {%- if parent.children.size > 0 %}
                    <ul>
                        {%- for child in parent.children %}
                        <li><a href="{{ child.url }}">{{ child.title }}</a></li>
                        {%- endfor %}
                    </ul>
                    {%- endif %}
                </li>
                {%- endfor %}
                <li><a href="{{ blog.archive_url }}">{{ 'archive' | t }}</a></li>
                <li><a href="{{ blog.contact_url }}">{{ 'contact' | t }}</a></li>
                {%- unless is_page %}
                {%- if user.is_authenticated %}
                <li><a href="{{ blog.admin_url }}"><span>{{ 'admin' | t }}</span></a></li>
                {%- else %}
                <li><a href="{{ blog.login_url }}"><span>{{ 'login' | t }}</span></a></li>
                {%- endif %}
                {%- endunless %}
            </ul>
            {% widget_zone 'sidebar' %}
        </div>
    </div>

    <div class="overlay"></div>

    <!-- START FOOTER -->
    <div class="container container-footer">
        <footer class="blog-footer ">
            <ul class="nav blog-social mx-auto justify-content-center">
                <li><a class="item-fb" data-toggle="tooltip" title="follow on Facebook" target="_blank" href="{{ 'Facebook Account' | theme_field: '#/' }}" rel="external nofollow"><i class="fa fa-facebook"></i></a></li>
                <li><a class="item-tw" data-toggle="tooltip" title="follow on Twitter" target="_blank" href="{{ 'Twitter Account' | theme_field: '#/' }}" rel="external nofollow"><i class="fa fa-twitter"></i></a></li>
                <li><a class="item-gp" data-toggle="tooltip" title="follow on Google +" target="_blank" href="{{ 'Google Plus Account' | theme_field: '#/' }}" rel="external nofollow"><i class="fa fa-google-plus"></i></a></li>
                <li><a class="item-li" data-toggle="tooltip" title="follow on Linkedin" target="_blank" href="{{ 'Linkedin Account' | theme_field: '#/' }}" rel="external nofollow"><i class="fa fa-linkedin"></i></a></li>
                <li><a class="item-in" data-toggle="tooltip" title="follow on Instagram" target="_blank" href="{{ 'Instagramm Account' | theme_field: '#/' }}" rel="external nofollow"><i class="fa fa-instagram"></i></a></li>
                <li><a class="item-yt" data-toggle="tooltip" title="follow on YouTube" target="_blank" href="{{ 'Youtube Account' | theme_field: '' }}" rel="external nofollow"><i class="fa fa-youtube"></i></a></li>
                <li><a class="item-pi" data-toggle="tooltip" title="follow on Pinterest" target="_blank" href="{{ 'Pinterest Account' | theme_field: '' }}" rel="external nofollow"><i class="fa fa-pinterest"></i></a></li>
                <li><a class="item-gb" data-toggle="tooltip" title="follow on GitHub" target="_blank" href="{{ 'Github Account' | theme_field: '' }}" rel="external nofollow"><i class="fa fa-git"></i></a></li>
            </ul>
            <div class="blog-copyright mx-auto mt-3 text-center">
                <span class="d-block">&copy; {{ blog.year }}</span>
                <span>Designed by <a href="https://blogengine.io/themes/" rel="nofollow" target="_blank">BlogEngine</a></span>
            </div>
        </footer>
    </div>
    <!-- END FOOTER -->

    <i class="goup fa fa-chevron-up"></i>

    <script src="{{ 'src/js/popper.min.js' | theme_url }}"></script>
    <script src="{{ 'src/js/bootstrap.min.js' | theme_url }}"></script>
    <script src="{{ 'src/js/perfect-scrollbar.min.js' | theme_url }}"></script>
    <script src="{{ 'src/js/custom.js' | theme_url }}"></script>
    <script type="application/ld+json">
        {
            "@context": "http://schema.org",
            "@type": "WebSite",
            "url": "{{ blog.absolute_url }}",
            "potentialAction": {
                "@type": "SearchAction",
                "target": "{{ blog.absolute_url }}search?q={search_term_string}",
                "query-input": "required name=search_term_string"
            }
        }
    </script>
    {{ content_for_footer }}
    <!-- {{ blog.version }} -->
</body>
</html>

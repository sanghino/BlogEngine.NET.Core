{%- comment -%} Tema Standard-2017: porting di PostView.ascx. {%- endcomment -%}
<article class="post" id="post{{ post.index }}">
    <header class="post-header">
        <h2 class="post-title">
            <a href="{{ post.url }}">{{ post.title }}</a>
        </h2>
        <div class="post-info clearfix">
            <span class="post-date">{{ post.date_created | date_format: 'dd MMMM yyyy' }}</span>
            <span class="post-author"><a href="{{ post.author_url }}">{{ post.author_name }}</a></span>
            <span class="post-category">{% for c in post.categories %}<a href="{{ c.url }}">{{ c.title }}</a>{% unless forloop.last %}, {% endunless %}{% endfor %}</span>
        </div>
    </header>
    <section class="post-body text">
        {{ post.body }}
    </section>
    {%- if location == 'single' %}
    <footer class="post-footer">
        <div class="post-tags">
            {{ 'tags' | t }} : {% for tag in post.tags %}<a href="{{ tag.url }}" rel="tag">{{ tag.title }}</a>{% unless forloop.last %}, {% endunless %}{% endfor %}
        </div>
        <div class="post-rating">
            {{ post.rating_html }}
        </div>
        <div class="post-adminlinks">{{ post.admin_links }}</div>
    </footer>
    {%- endif %}
</article>

{%- comment -%}
  Tema Fiorentina (porting di PostView.ascx): data a calendario, titolo, autore, testo, annuncio a fine
  post (solo nel post singolo), tag e categorie, condivisione e link. L'annuncio parte solo con il
  consenso "marketing". Editore (ca-pub-...) e slot si impostano in Personalizza → Temi → campi
  personalizzati: finché sono vuoti l'annuncio non compare.
{%- endcomment -%}
<div class="post xfolkentry" id="post{{ post.index }}">
    <div class="post-header">
        <div class="data">
            <span class="d">{{ post.date_created | date_format: 'dd' }}</span>
            <span class="m">{{ post.date_created | date_format: 'MMM' }}</span>
            <span class="y">{{ post.date_created | date_format: 'yyyy' }}</span>
        </div>
        <div class="post-title">
            <h1><a href="{{ post.url }}" class="taggedlink">{{ post.title }}</a></h1>
            <span class="author">Scritto da <a href="{{ post.author_url }}">{{ post.author_name }}</a></span>
        </div>
    </div>

    <div class="text">{{ post.body }}</div>

    {%- if location == 'single' %}
    {%- assign ad_client = 'AdSense editore' | theme_field: '' | strip -%}
    {%- assign ad_slot = 'AdSense slot fine post' | theme_field: '' | strip -%}
    {%- if ad_client != '' and ad_slot != '' %}
    {%- capture ad_code -%}
        <script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client={{ ad_client }}" crossorigin="anonymous"></script>
        <ins class="adsbygoogle" style="display:inline-block;width:650px;height:100px" data-ad-client="{{ ad_client }}" data-ad-slot="{{ ad_slot }}"></ins>
        <script>(adsbygoogle = window.adsbygoogle || []).push({});</script>
    {%- endcapture %}
    <div class="ads-post-bottom">{{ ad_code | consent: 'marketing' }}</div>
    {%- endif %}
    {%- endif %}

    {{ post.rating_html }}

    {%- if post.tags.size > 0 or post.categories.size > 0 %}
    <div class="bottom">
        {%- if post.tags.size > 0 %}
        <p class="tags"><strong>{{ 'tags' | t }}:</strong> {% for tag in post.tags %}<a href="{{ tag.url }}" rel="tag">{{ tag.title }}</a>{% unless forloop.last %}, {% endunless %}{% endfor %}</p>
        {%- endif %}
        {%- if post.categories.size > 0 %}
        <p class="categories"><strong>{{ 'categories' | t }}:</strong> {% for c in post.categories %}<a href="{{ c.url }}">{{ c.title }}</a>{% unless forloop.last %} | {% endunless %}{% endfor %}</p>
        {%- endif %}
    </div>
    {%- endif %}

    <div class="footer">
        <div class="social-share">
            <span class="label">Condividi:</span>
            <a class="share whatsapp" href="https://api.whatsapp.com/send?text={{ post.title | append: ' - ' | append: post.absolute_url | url_encode }}" target="_blank" rel="noopener nofollow">WhatsApp</a>
            <a class="share telegram" href="https://telegram.me/share/url?url={{ post.absolute_url | url_encode }}&amp;text={{ post.title | url_encode }}" target="_blank" rel="noopener nofollow">Telegram</a>
            <a class="share x" href="https://twitter.com/intent/tweet?text={{ post.title | url_encode }}&amp;url={{ post.absolute_url | url_encode }}" target="_blank" rel="noopener nofollow">X</a>
            <a class="share facebook" href="https://www.facebook.com/sharer/sharer.php?u={{ post.absolute_url | url_encode }}" target="_blank" rel="noopener nofollow">Facebook</a>
        </div>
        <div class="post-links">
            <span>
                <a rel="bookmark" href="{{ post.absolute_url }}" class="permalink">Permalink</a> |
                <a rel="nofollow" href="{{ post.url }}#comment">{{ 'comments' | t }} ({{ post.comments_count }})</a> |
                <a rel="nofollow" href="{{ post.feed_url }}">RSS commenti</a>
            </span>
            {%- if post.admin_links != '' %}<span class="post-adminlinks">{{ post.admin_links }}</span>{% endif %}
        </div>
    </div>
</div>

<Project Sdk="Microsoft.NET.Sdk.Web">

  <ItemGroup>
    <ProjectReference Include="..\BlogEngine.Core\BlogEngine.Core.csproj" />
    <ProjectReference Include="..\BlogEngine.Data.Xml\BlogEngine.Data.Xml.csproj" />
    <ProjectReference Include="..\BlogEngine.Data.Sqlite\BlogEngine.Data.Sqlite.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <!-- Pacchetto "portable": IIS avvia il sito con "dotnet BlogEngine.Web.dll", vale per 32 e 64 bit.
         Il pacchetto self-contained (tools/publish-aruba.ps1) usa invece BlogEngine.Web.exe. -->
    <UseAppHost Condition="'$(SelfContained)' != 'true'">false</UseAppHost>
    <!-- Solo le traduzioni in inglese e italiano delle librerie (es. i messaggi di Roslyn): pacchetto più leggero. -->
    <SatelliteResourceLanguages>en;it</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Fluid.Core" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.NewtonsoftJson" />
    <!-- Compilatore C# per le estensioni copiate come sorgenti .cs. -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" />
    <PackageReference Include="System.ServiceModel.Syndication" />
  </ItemGroup>

  <ItemGroup>
    <Content Update="appsettings.Development.json" CopyToPublishDirectory="Never" />
    <!-- Elenco delle etichette passate all'amministrazione (admin.res.axd). -->
    <Content Include="Resources\AdminLabels.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <!-- I sorgenti delle estensioni non fanno parte del sito: vengono compilati da soli all'avvio. -->
    <Compile Remove="Custom\**" />
  </ItemGroup>

  <ItemGroup>
    <!-- Temi, widget e template Liquid: letti dal disco a ogni modifica, vanno pubblicati così come sono. -->
    <Content Remove="Custom\**;Templates\**" />
    <None Remove="Custom\**;Templates\**" />
    <Content Include="Custom\**;Templates\**" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <!-- I dati locali di sviluppo non vanno pubblicati: in produzione stanno in ../App_Data. -->
    <Content Remove="App_Data\**" />
    <None Remove="App_Data\**" />
  </ItemGroup>

  <!-- TinyMCE (licenza GPL) non sta nel repository: lo scarica tools/get-tinymce.ps1, con verifica dell'impronta,
       quando la cartella manca o lo script è cambiato (nuova versione). Poi finisce nella build e nei pacchetti. -->
  <PropertyGroup>
    <TinyMceScript>$(MSBuildProjectDirectory)\..\..\tools\get-tinymce.ps1</TinyMceScript>
    <TinyMceStamp>$(MSBuildProjectDirectory)\wwwroot\lib\tinymce\version.txt</TinyMceStamp>
    <TinyMcePowerShell Condition="'$(OS)' == 'Windows_NT'">powershell.exe</TinyMcePowerShell>
    <TinyMcePowerShell Condition="'$(OS)' != 'Windows_NT'">pwsh</TinyMcePowerShell>
  </PropertyGroup>

  <Target Name="DownloadTinyMce" BeforeTargets="BeforeBuild" Condition="'$(DesignTimeBuild)' != 'true'"
          Inputs="$(TinyMceScript)" Outputs="$(TinyMceStamp)">
    <Exec Command="$(TinyMcePowerShell) -NoProfile -NonInteractive -ExecutionPolicy Bypass -File &quot;$(TinyMceScript)&quot;" />
    <!-- I file appena scaricati non c'erano quando il progetto è stato letto: si aggiungono qui ai file del sito. -->
    <ItemGroup>
      <Content Remove="wwwroot\lib\tinymce\**" />
      <Content Include="wwwroot\lib\tinymce\**" CopyToPublishDirectory="PreserveNewest" />
    </ItemGroup>
  </Target>

</Project>

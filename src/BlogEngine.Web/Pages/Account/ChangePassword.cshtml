@page "/account/change-password"
@model BlogEngine.Web.Pages.Account.ChangePasswordModel
@{
    ViewData["Title"] = L["changePassword"];
}
@if (Model.Completed)
{
    <p class="success">@L["passwordChangeSuccess"]</p>
}
else
{
    <form method="post">
        <div asp-validation-summary="All" class="error"></div>

        <label asp-for="OldPassword">@L["oldPassword"]</label>
        <input asp-for="OldPassword" type="password" autocomplete="current-password" required />

        <label asp-for="NewPassword">@L["passwordMinimumCharacters", Model.MinimumPasswordLength]</label>
        <input asp-for="NewPassword" type="password" autocomplete="new-password" minlength="@Model.MinimumPasswordLength" required />

        <label asp-for="ConfirmPassword">@L["confirmNewPassword"]</label>
        <input asp-for="ConfirmPassword" type="password" autocomplete="new-password" required />

        <button type="submit">@L["changePassword"]</button>
    </form>
}
<p class="links"><a href="~/">@L["home"]</a></p>

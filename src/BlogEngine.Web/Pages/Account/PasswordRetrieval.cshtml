@page "/account/password-retrieval"
@model BlogEngine.Web.Pages.Account.PasswordRetrievalModel
@{
    ViewData["Title"] = L["passwordRetrieval"];
}
@if (!Model.Enabled)
{
    <p class="error">@L["passwordRetrieval"]: —</p>
}
else if (Model.Requested)
{
    <p class="success">@L["resetPasswordRequested"]</p>
}
else
{
    <p>@L["resetPasswordIntro"]</p>
    <form method="post">
        <div asp-validation-summary="ModelOnly" class="error"></div>
        <label asp-for="UserName">@L["userName"]</label>
        <input asp-for="UserName" type="text" autocomplete="username" required />
        <button type="submit">@L["send"]</button>
    </form>
}
<p class="links"><a asp-page="/Account/Login">@L["login"]</a></p>

@page "/account/reset-password"
@model BlogEngine.Web.Pages.Account.ResetPasswordModel
@{
    ViewData["Title"] = L["resetPassword"];
}
@if (Model.Completed)
{
    <p class="success">@L["passwordResetSuccess"]</p>
}
else if (!Model.TokenIsValid)
{
    <p class="error">@L["resetLinkInvalid"]</p>
}
else
{
    <form method="post">
        <div asp-validation-summary="All" class="error"></div>
        <input type="hidden" asp-for="Token" />

        <label asp-for="NewPassword">@L["passwordMinimumCharacters", Model.MinimumPasswordLength]</label>
        <input asp-for="NewPassword" type="password" autocomplete="new-password" minlength="@Model.MinimumPasswordLength" required />

        <label asp-for="ConfirmPassword">@L["confirmNewPassword"]</label>
        <input asp-for="ConfirmPassword" type="password" autocomplete="new-password" required />

        <button type="submit">@L["save"]</button>
    </form>
}
<p class="links"><a asp-page="/Account/Login">@L["login"]</a></p>

@page "/admin/about.cshtml"
@model BlogEngine.Web.Pages.Admin.AboutModel
@{
    Layout = "_AdminLayout";
}
<div class="about-view content">
    <button tabindex="-1" class="sidebar-toggle"><span></span><span></span><span></span></button>
    <div class="main-header clearfix">
        <h2 class="page-title pull-left">@L["about"]</h2>
    </div>
    <div class="content-inner">
        <div class="about-section">
            <div class="about-logo"><img src="~/Content/images/brand/logo.svg" alt="ExtraGeek-BlogEngine" style="width:360px;max-width:100%" /></div>
            <p class="text-justify">@L["aboutDescription"]</p>
        </div>
        <div class="panel panel-default">
            <div class="panel-heading">
                <div class="panel-title" style="text-transform:none">@L["aboutSpecification"]</div>
            </div>
            <ul class="list-group">
                <li class="list-group-item">
                    <span> Version:</span> ExtraGeek-BlogEngine @BlogEngine.Web.Hosting.BuildInfo.Current.Describe(L["diagLocalChanges"])
                </li>
                <li class="list-group-item">
                    <span>Trust level:</span> Full (.NET @Environment.Version)
                </li>
                <li class="list-group-item">
                    <span>Identity:</span> @(Environment.UserDomainName)\@Environment.UserName
                </li>
                <li class="list-group-item">
                    <span>Blog provider:</span> @Model.DataProvider
                </li>
                @if (Admin.IsAdministrator)
                {
                    <li class="list-group-item">
                        <a href="~/admin/diagnostics"><i class="fa fa-stethoscope"></i> @L["diagLink"]</a>
                    </li>
                }
                <li class="list-group-item">
                    <span>Membership provider:</span> ExtraGeek-BlogEngine (@Model.DataProvider)
                </li>
                <li class="list-group-item">
                    <span>Role provider:</span> ExtraGeek-BlogEngine (@Model.DataProvider)
                </li>
            </ul>
        </div>
    </div>
</div>

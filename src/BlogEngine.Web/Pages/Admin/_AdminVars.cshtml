@using System.Text.Json
@{
    // Variabili lette dal JavaScript dell'amministrazione (stessi nomi della versione originale).
    var userVars = new
    {
        Name = Admin.UserName,
        IsAdmin = Admin.IsAdministrator ? "True" : "False",
        Rights = Admin.UserRights.Select(r => r.ToString()).ToArray(),
    };
    var now = DateTime.Now;
}
<script type="text/javascript">
    var UserVars = @Html.Raw(JsonSerializer.Serialize(userVars));
    var ActiveTheme = @Html.Raw(JsonSerializer.Serialize(Admin.ActiveTheme));
    var UsageScenario = @Html.Raw(JsonSerializer.Serialize(Admin.Options.UsageScenario));
    var ServerTime = @Html.Raw(JsonSerializer.Serialize(now.ToString()));
    var UtcTime = @Html.Raw(JsonSerializer.Serialize(now.ToUniversalTime().ToString()));
</script>
<script type="text/javascript" src="@(Admin.BlogRoot)admin/admin.res.axd"></script>

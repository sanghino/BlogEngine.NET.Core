{%- comment -%} Modulo dei commenti (porting di CommentForm.ascx): blog.js legge i campi tramite il loro id. {%- endcomment -%}
<div class="commentForm">
    <h3 id="addcomment">{{ 'addComment' | t }}</h3>
    <p>
        <label for="txtName" class="lbl-user">{{ 'name' | t }}*</label>
        <input type="text" class="txt-user" name="txtName" id="txtName" maxlength="100" />
    </p>
    <p>
        <label for="txtEmail" class="lbl-email">{{ 'email' | t }}*</label>
        <input type="email" class="txt-email" id="txtEmail" maxlength="200" />
    </p>
    {%- if comments.show_website %}
    <p>
        <label for="txtWebsite" class="lbl-website">{{ 'website' | t }}</label>
        <input type="text" class="txt-website" id="txtWebsite" maxlength="300" />
    </p>
    {%- endif %}
    <p>
        <label for="txtContent" class="lbl-content">{{ 'comment' | t }}*</label>
        <textarea class="txt-content" id="txtContent" cols="50" rows="10" name="txtContent"></textarea>
    </p>
    <p>
        <input type="checkbox" id="cbNotify" class="cmnt-frm-notify" style="width: auto" />
        <label for="cbNotify" style="width: auto; float: none; display: inline; padding-left: 5px">{{ 'notifyOnNewComments' | t }}</label>
    </p>
    <p>
        <input type="button" id="btnSaveAjax" class="btn-save" style="margin-top: 10px" value="{{ 'saveComment' | t }}" onclick="return BlogEngine.validateAndSubmitCommentForm()" />
    </p>
</div>

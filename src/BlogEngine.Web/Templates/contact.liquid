{%- comment -%}
  Modulo di contatto (porting di contact.aspx). Variabili: contact (message, thank_message, error_message,
  allow_attachments, sent, failed, name, email, subject, text, errors) e antiforgery (campo nascosto obbligatorio).
{%- endcomment -%}
<div id="contact" class="contact-page page-global">
    {%- if contact.sent %}
    <div id="thanks"><div id="divThank">{{ contact.thank_message }}</div></div>
    {%- else %}
    <form id="divForm" method="post" action="{{ blog.contact_url }}" enctype="multipart/form-data">
        {{ antiforgery }}
        <h2 class="contact-page-title page-global-title">{{ 'contact' | t }}</h2>
        <div class="contact-page-message">{{ contact.message }}</div>
        {%- if contact.errors.size > 0 %}
        <ul class="required-field">{% for error in contact.errors %}<li>{{ error }}</li>{% endfor %}</ul>
        {%- endif %}
        <div class="form-group">
            <label for="txtName">{{ 'name' | t }}</label>
            <input type="text" id="txtName" name="name" class="field form-control" value="{{ contact.name }}" required maxlength="100" />
        </div>
        <div class="form-group">
            <label for="txtEmail">{{ 'email' | t }}</label>
            <input type="email" id="txtEmail" name="email" class="field form-control" value="{{ contact.email }}" required maxlength="200" />
        </div>
        <div class="form-group">
            <label for="txtSubject">{{ 'subject' | t }}</label>
            <input type="text" id="txtSubject" name="subject" class="field form-control" value="{{ contact.subject }}" required maxlength="200" />
        </div>
        <div class="form-group">
            <label for="txtMessage">{{ 'message' | t }}</label>
            <textarea id="txtMessage" name="message" class="form-control" rows="5" cols="30" required>{{ contact.text }}</textarea>
        </div>
        {%- if contact.allow_attachments %}
        <div class="form-group">
            <label for="txtAttachment">{{ 'attachFile' | t }}</label>
            <input type="file" id="txtAttachment" name="attachment" />
        </div>
        {%- endif %}
        <div style="display:none"><input type="text" name="hp" tabindex="-1" autocomplete="off" /></div>
        <div class="text-right btn-wrapper">
            <button type="submit" id="btnSend" class="btn btn-primary">{{ 'send' | t }}</button>
            {%- if contact.failed %}<span id="lblStatus">{{ contact.error_message }}.</span>{% endif %}
        </div>
    </form>
    {%- endif %}
</div>

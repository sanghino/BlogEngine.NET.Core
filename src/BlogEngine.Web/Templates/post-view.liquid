{%- comment -%}
  Un post nell'elenco (location = 'list') o da solo (location = 'single'). Porting di PostView.ascx.
  post.body contiene il testo (o il riassunto) già elaborato dalle estensioni.
{%- endcomment -%}
<article class="post" id="post{{ post.index }}">
    <h2><a href="{{ post.url }}">{{ post.title }}</a></h2>
    <div class="post-meta">
        {{ post.date_created | date_format: 'D' }} - <a href="{{ post.author_url }}">{{ post.author_name }}</a>
        {%- if post.categories.size > 0 %} - {% for c in post.categories %}<a href="{{ c.url }}">{{ c.title }}</a>{% unless forloop.last %}, {% endunless %}{% endfor %}{% endif %}
    </div>
    <div class="post-body">{{ post.body }}</div>
    {%- if location == 'single' %}
    {%- if post.tags.size > 0 %}
    <div class="post-tags">{{ 'tags' | t }}: {% for tag in post.tags %}<a href="{{ tag.url }}" rel="tag">{{ tag.title }}</a>{% unless forloop.last %}, {% endunless %}{% endfor %}</div>
    {%- endif %}
    {{ post.rating_html }}
    {%- endif %}
    {%- if post.admin_links != '' %}<div class="post-adminlinks">{{ post.admin_links }}</div>{% endif %}
</article>

{%- comment -%}
  Un sondaggio (widget Poll e pagina /polls). Variabile: poll. Se il visitatore può votare mostra le risposte
  da scegliere, altrimenti i risultati (se li può vedere) o il motivo per cui non li vede. Dopo il voto
  blog.js (BlogEngine.votePoll) sostituisce il contenuto con i risultati ricevuti dal sito.
{%- endcomment -%}
<div class="poll poll-{{ poll.status }}" id="poll-{{ poll.id }}" data-poll="{{ poll.id }}" data-max="{{ poll.max_choices }}">
    {%- unless poll_page %}
    <p class="poll-question">{% if poll.url == '' %}{{ poll.question }}{% else %}<a href="{{ poll.url }}">{{ poll.question }}</a>{% endif %}</p>
    {%- endunless %}
    {%- if poll.description != '' %}<p class="poll-description">{{ poll.description }}</p>{% endif %}
    <div class="poll-body">
    {%- if poll.can_vote %}
        <form class="poll-form" onsubmit="return BlogEngine.votePoll('{{ poll.id }}', this);">
            {%- if poll.multiple_choice %}
            <p class="poll-hint">{% if poll.max_choices > 0 %}{{ 'pollChooseUpTo' | t | replace: '{0}', poll.max_choices }}{% else %}{{ 'pollChooseMany' | t }}{% endif %}</p>
            {%- endif %}
            <ul class="poll-options">
                {%- for option in poll.options %}
                <li><label><input type="{% if poll.multiple_choice %}checkbox{% else %}radio{% endif %}" name="poll-{{ poll.id }}" value="{{ option.id }}" /> {{ option.text }}</label></li>
                {%- endfor %}
            </ul>
            <p class="poll-message" hidden></p>
            <button type="submit" class="btn btn-primary poll-button">{{ 'pollVote' | t }}</button>
        </form>
    {%- elsif poll.show_results %}
        <ul class="poll-results">
            {%- for option in poll.options %}
            <li class="{% if option.winner %}poll-winner{% endif %}">
                <span class="poll-option">{{ option.text }}</span>
                <span class="poll-count">{{ option.percent }}% ({{ option.votes }})</span>
                <span class="poll-bar"><span style="width: {{ option.percent }}%"></span></span>
            </li>
            {%- endfor %}
        </ul>
        <p class="poll-voters">{{ 'pollVoters' | t }}: {{ poll.voters }}</p>
    {%- elsif poll.login_required and poll.status == 'open' %}
        <p class="poll-message">{{ 'pollLoginRequired' | t }}</p>
    {%- elsif poll.has_voted %}
        <p class="poll-message">{{ 'pollThankYou' | t }} {{ 'pollResultsAfterClose' | t }}</p>
    {%- else %}
        <p class="poll-message">{{ 'pollResultsAfterClose' | t }}</p>
    {%- endif %}
    </div>
    {%- if poll.status == 'closed' and poll.ended %}
    <p class="poll-dates">{{ 'pollEnded' | t }} {{ poll.ended | date_format: 'd MMMM yyyy' }}</p>
    {%- elsif poll.ends %}
    <p class="poll-dates">{{ 'pollEnds' | t }} {{ poll.ends | date_format: 'd MMMM yyyy, HH:mm' }}</p>
    {%- endif %}
</div>

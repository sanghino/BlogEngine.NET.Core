<Project Sdk="Microsoft.NET.Sdk">

  <!-- SDK pubblico per temi ed estensioni: tutto ciò che è qui è un contratto da mantenere stabile. -->
  <PropertyGroup>
    <RootNamespace>BlogEngine</RootNamespace>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- Le estensioni registrano i propri componenti nel contenitore dei servizi. -->
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
  </ItemGroup>

</Project>
